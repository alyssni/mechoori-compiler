classe Italian{
    publicco statico vuoto principale (stringa [] args){
        //Declare variables
        galleggiante X1,Y1; 
        intero I,J,K;
        
        //Initialize values
        X1=0;
        Y1=10;
        K=10;
        J=-10;

        per (I=1;I+10<=K;I=I-1){
            mentre (K+I<20){
                 J=I;

                 fare{
                     se (X1>Y1)
                         J=J-2;
                     altrimenti
                         J=J/4;
                     X1=X1*2.0;
                 }
                 mentre (J>=20);
                 K=K+3;
            }
        }
   }
}