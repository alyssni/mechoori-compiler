Package mechoori;

Helpers // Examples
  letter = ['a'..'z'] | ['A'..'Z'] ;             // w
  digit = ['0'..'9'] ;                           // 3
  digits = digit+ ; 				// 2040099
  exp = ['e' + 'E'] ['+' + '-']? digits;         // E-34
  newline = [10 + 13] ; 				// '\n'
  non_star = [[0..0xffff] - '*'] ;               // /
  non_slash = [[0..0xffff] - '/'];               // *
  non_star_slash = [[0..0xffff] - ['*' + '/']];  // $
Tokens
  comment1 = '//' [[0..0xffff]-newline]* newline ;
  comment2 = '/*' non_star* '*'  (non_star_slash non_star* '*'+)* '/' ;
  space = ' ' | 9 | newline ; // 9 = tab
  clas   = 'class'  | 'classe'       | 'klase'         | 'sinf' ; 	// key words (reserved)
  public = 'public' | 'publicco'     | 'pampubliko'    | 'aam' ;
  static = 'static' | 'statico'      | 'static'        | 'thabit' ;      
  void   = 'void'   | 'vuoto'        | 'walang bisa'   | 'farigh' ;
  main   = 'main'   | 'principale'   | 'pangunahing'   | 'raeisi' ;
  string = 'String' | 'stringa'      | 'string'        | 'nass' ;
  int    = 'int'    | 'intero'       | 'int'           | 'sahih' ;
  float  = 'float'  | 'galleggiante' | 'lumutang'      | 'ashari' ;
  for    = 'for'    | 'per'          | 'para sa'       | 'karrir'; 
  while  = 'while'  | 'mentre'       | 'habang'        | 'talama' ;  
  if     = 'if'     | 'se'           | 'kung'          | 'idha' ; 
  else   = 'else'   | 'altrimenti'   | 'iba pa'        | 'wailla' ; 
  do     = 'do'     | 'fare'         | 'gawin'         | 'ifaal' ;   
  assign = '=' ;
  compare = '==' | '<' | '>' | '<=' | '>=' | '!=' ;
  plus = '+' ;
  minus = '-' ;
  mult = '*' ;
  div = '/' ;
  l_par = '(' ;
  r_par = ')' ;
  l_brace = '{' ;
  r_brace = '}' ;
  l_bracket = '[' ;
  r_bracket = ']' ;
  comma = ',' ;
  semi = ';' ;
  identifier = letter (letter | digit | '_')* ;
  number = (digits '.'? digits? | '.'digits) exp? ;
  misc = [0..0xffff] ;

